[
  {
    "name": "shimOk",
    "expression": "has(object.request.args) && size(object.request.args) > 0 && object.request.args[0].endsWith('nono-shim')"
  },
  {
    "name": "argv",
    "expression": "!has(object.request.args) || size(object.request.args) <= 1 ? [] : object.request.args.slice(1, size(object.request.args))"
  },
  {
    "name": "isKubectl",
    "expression": "object.request.capability_type == 'command' && (object.request.command == 'kubectl' || object.request.command.endsWith('/kubectl'))"
  },
  {
    "name": "isReadOnlyKubectl",
    "expression": "derived.shimOk && size(derived.argv) > 0 && derived.argv[0] in ['get','describe','logs','top','explain','api-resources','api-versions','version','cluster-info']"
  }
]
